{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/check_style.py\" --hook codex",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/clang_tidy_hook.py\" --hook codex",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
